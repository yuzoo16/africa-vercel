# Generated by apply-redirects.js.
# All rules use mod_rewrite: mixing mod_alias "Redirect" with RewriteRule
# is evaluated in a different phase and produces chains or loops.
RewriteEngine On
RewriteBase /

# 1. scheme: canonical/hreflang/sitemap all declare https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. host: non-www -> www (the declared preferred domain)
RewriteCond %{HTTP_HOST} ^adventuresafariafrica\.com$ [NC]
RewriteRule ^ https://www.adventuresafariafrica.com%{REQUEST_URI} [R=301,L]

# 3. stub pages -> their canonical destination
RewriteRule ^great-migration-safari/?$$ /tanzania-migration-safari/ [R=301,L]
RewriteRule ^de/migrations-safari/?$$ /de/migration-tansania/ [R=301,L]
RewriteRule ^fr/safari-migration/?$$ /fr/migration-tanzanie/ [R=301,L]
RewriteRule ^es/safari-migracion/?$$ /es/migracion-tanzania/ [R=301,L]
RewriteRule ^it/safari-migrazione/?$$ /it/migrazione-tanzania/ [R=301,L]

ErrorDocument 404 /404.html
